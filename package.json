{
  "name": "@letslego/helix-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Helix HTTP API (/helix/v1) — sessions, approvals, workflows, events.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/letslego/helix-sdk.git"
  },
  "homepage": "https://github.com/letslego/helix-sdk#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --import tsx --test test/**/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "engines": { "node": ">=20" },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "publishConfig": { "access": "public" },
  "keywords": ["helix", "agents", "sdk", "ai-agents", "letslego"]
}
